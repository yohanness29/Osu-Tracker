{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "ESNext.Collection", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["packages/*/src", "packages/*/*.ts", "tools", "vitest.config.ts"]
}
